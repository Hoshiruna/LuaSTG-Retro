{
  "version": 6,
  "include": [
    "cmake/presets/base.json"
  ],
  "configurePresets": [
    {
      "name": "vs2026-amd64",
      "inherits": [
        "vs2026"
      ],
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/vs2026/amd64"
    }
  ],
  "buildPresets": [
    {
      "name": "windows-vs2026-amd64-debug",
      "configurePreset": "vs2026-amd64",
      "inherits": [
        "debug",
        "target-luastg"
      ]
    },
    {
      "name": "windows-vs2026-amd64-release",
      "configurePreset": "vs2026-amd64",
      "inherits": [
        "release",
        "target-luastg"
      ]
    }
  ],
  "workflowPresets": [
    {
      "name": "windows-vs2026-amd64-release",
      "steps": [
        {
          "type": "configure",
          "name": "vs2026-amd64"
        },
        {
          "type": "build",
          "name": "windows-vs2026-amd64-release"
        }
      ]
    }
  ]
}
