{
  "version": 6,
  "configurePresets": [
    {
      "name": "my-steam-api",
      "hidden": true,
      "cacheVariables": {
        "LUASTG_STEAM_API_ENABLE": {
          "type": "BOOL",
          "value": "TRUE"
        },
        "LUASTG_STEAM_API_APP_ID": {
          "type": "STRING",
          "value": "123456"
        },
        "LUASTG_STEAM_API_FORCE_LAUNCH_BY_STEAM": {
          "type": "BOOL",
          "value": "TRUE"
        }
      }
    },
    {
      "name": "windows-x64-my-steam-api",
      "inherits": [
        "windows-x64",
        "my-steam-api"
      ],
      "binaryDir": "${sourceDir}/build/windows-x64-my-steam-api"
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64-my-steam-api-debug",
      "configurePreset": "windows-x64-my-steam-api",
      "configuration": "Debug",
      "targets": ["LuaSTG", "Setting"]
    },
    {
      "name": "windows-x64-my-steam-api-release",
      "configurePreset": "windows-x64-my-steam-api",
      "configuration": "Release",
      "targets": ["LuaSTG", "Setting"]
    }
  ],
  "workflowPresets": [
    {
      "name": "windows-x64-my-steam-api-release",
      "steps": [
        {
          "type": "configure",
          "name": "windows-x64-my-steam-api"
        },
        {
          "type": "build",
          "name": "windows-x64-my-steam-api-release"
        }
      ]
    }
  ]
}
